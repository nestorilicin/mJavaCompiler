program Test15

int numbers[];
int i;
int total;

{

void main()
{
    numbers = new int[10];

    total = 0;

    for(i = 0; i < numbers.length; i++)
    {
        numbers[i] = i * i;
    }

    for(i = 0; i < numbers.length; i++)
    {
        total = total + numbers[i];
    }

    print(total); // 285
}

}