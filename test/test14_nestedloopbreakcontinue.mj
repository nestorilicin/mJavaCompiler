program Test14

int i;
int j;
int sum;

{

void main()
{
    sum = 0;

    for(i = 1; i <= 5; i++)
    {
        if(i == 3)
            continue;

        for(j = 1; j <= 5; j++)
        {
            if(j == 4)
                break;

            sum = sum + i * j;
        }
    }

    print(sum); // 72
}

}